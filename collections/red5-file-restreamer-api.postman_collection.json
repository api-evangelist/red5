      "name": "File Restreamer",
      "description": {
        "content": "Restream recorded FLV or MP4 files as pseudo-live streams",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "451d092f-844a-49bf-92f1-e4076aeb6811",
          "name": "Create File Restream Provision",
          "request": {
            "name": "Create File Restream Provision",
            "description": {
              "content": "Creates a provision that restreams a recorded FLV or MP4 file as a pseudo-live stream. The file is played back continuously or on loop, allowing pre-recorded content to be distributed as a live stream.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "filerestreamer",
                "provision.create"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accessToken",
                  "value": "<string>",
                  "description": "(Required) API access token for authentication"
                }
              ],
              "variable": [
                {
                  "description": "Hostname or IP address of the Red5 Pro server",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filePath\": \"<string>\",\n  \"streamName\": \"<string>\",\n  \"appName\": \"live\",\n  \"loop\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
