{
  "opencollection": "1.0.0",
  "info": {
    "name": "Red5 Pro Brew Mixer Admin Logs API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "accessToken",
      "value": "{{accessToken}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Server Logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{host}:5080/logs",
            "params": [
              {
                "name": "accessToken",
                "value": "",
                "type": "query",
                "description": "API access token for authentication"
              },
              {
                "name": "level",
                "value": "",
                "type": "query",
                "description": "Log level filter (INFO, WARN, ERROR, DEBUG)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of log entries to return"
              }
            ]
          },
          "docs": "Retrieves server log entries from the Red5 Pro server. Supports filtering by log level and date range to narrow results."
        }
      ]
    }
  ],
  "bundled": true
}