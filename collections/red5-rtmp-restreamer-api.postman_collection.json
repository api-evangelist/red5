        {
          "id": "541ed383-141d-4255-91db-42a19ab1a075",
          "name": "Create Rtmp Restream Provision",
          "request": {
            "name": "Create Rtmp Restream Provision",
            "description": {
              "content": "Creates a provision that configures the Red5 Pro server to push a live ingest stream to one or more external RTMP or RTMPS destinations such as Facebook Live, YouTube Live, or any RTMP-compatible CDN endpoint. Each destination is specified with a stream URL and stream key.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "restreamer",
                "provision.create"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accessToken",
                  "value": "<string>",
                  "description": "(Required) API access token for authentication"
                }
              ],
              "variable": [
                {
                  "description": "Hostname or IP address of the Red5 Pro server",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"streamName\": \"<string>\",\n  \"destinations\": [\n    {\n      \"url\": \"<string>\",\n      \"streamKey\": \"<string>\",\n      \"protocol\": \"rtmp\"\n    }\n  ],\n  \"appName\": \"live\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
