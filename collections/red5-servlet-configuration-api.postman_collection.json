            },
            "url": {
              "path": [
                "restreamer",
                "config"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accessToken",
                  "value": "<string>",
                  "description": "(Required) API access token for authentication"
                }
              ],
              "variable": [
                {
                  "description": "Hostname or IP address of the Red5 Pro server",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                }
              ]
            },
